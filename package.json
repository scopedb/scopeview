{
  "name": "@scopedb/scopeview",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scopedb/scopeview.git"
  },
  "homepage": "https://scopeview.scopedb.io",
  "bugs": {
    "url": "https://github.com/scopedb/scopeview/issues"
  },
  "description": "Lightweight Canvas charts and HTML scalars with exact readings and no runtime dependencies.",
  "keywords": [
    "canvas",
    "charts",
    "visualization",
    "typescript"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "node/*.mjs",
    "node/*.d.mts",
    "schemas/",
    "examples/documents/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./scopeview.js": "./dist/scopeview.js",
    "./fonts.css": "./dist/fonts.css",
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js"
    },
    "./chart/axis": {
      "types": "./dist/chart-axis.d.ts",
      "import": "./dist/chart-axis.js"
    },
    "./chart/scatter": {
      "types": "./dist/chart-scatter.d.ts",
      "import": "./dist/chart-scatter.js"
    },
    "./chart/donut": {
      "types": "./dist/chart-donut.d.ts",
      "import": "./dist/chart-donut.js"
    },
    "./chart/top-list": {
      "types": "./dist/chart-top-list.d.ts",
      "import": "./dist/chart-top-list.js"
    },
    "./chart/treemap": {
      "types": "./dist/chart-treemap.d.ts",
      "import": "./dist/chart-treemap.js"
    },
    "./trace": {
      "types": "./dist/trace.d.ts",
      "import": "./dist/trace.js"
    },
    "./flame": {
      "types": "./dist/flame.d.ts",
      "import": "./dist/flame.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "import": "./dist/report.js"
    },
    "./scalar": {
      "types": "./dist/scalar.d.ts",
      "import": "./dist/scalar.js"
    },
    "./interactions": {
      "types": "./dist/interactions.d.ts",
      "import": "./dist/interactions.js"
    },
    "./embed": {
      "types": "./node/embed.d.mts",
      "import": "./node/embed.mjs"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "import": "./dist/styles.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.json": "./dist/theme/design-tokens.json",
    "./schema/v1.json": "./schemas/v1/document.schema.json",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    }
  },
  "sideEffects": [
    "./src/register.ts",
    "./dist/register.js",
    "./dist/scopeview.js",
    "./dist/plot-*.js",
    "**/*.css",
    "./node/cli.mjs"
  ],
  "bin": {
    "scopeview": "node/cli.mjs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "node scripts/tokens.mjs --check && tsc --noEmit && tsc -p tsconfig.tests.json && vue-tsc -p tsconfig.docs.json --noEmit",
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "test:bundle": "node --test tests/bundle.test.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "biome format --write .",
    "lint": "biome format . && biome lint . --error-on-warnings",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm test:node && pnpm test:bundle && pnpm test:browser && pnpm test:package --artifact-output .local/releases/npm",
    "tokens:generate": "node scripts/tokens.mjs",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:deploy": "wrangler deploy",
    "test:node": "node --test tests/node/*.test.mjs",
    "test:package": "node tests/package/run.mjs",
    "build:cli": "pnpm build && node scripts/distribution.mjs",
    "test:cli": "node tests/distribution.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "ajv": "8.17.1",
    "shiki": "2.5.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.4"
}
